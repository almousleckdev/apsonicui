import type { FeatureCard } from "@/components/service";

// Translated text (title/description/ctaText) comes from the "services"
// namespace - see messages/README.md for the data-file-as-function-of-t pattern.
// Non-text fields (id/image/href) are fixed regardless of locale.
export function getFeatureCards(t: (key: string) => string): FeatureCard[] {
  return [
    {
      id: "locations-manuals",
      image: "/products/AP110-A-PLUS(白).png",
      imageScale: 0.75,
      title: t("featureCards.locations.title"),
      description: t("featureCards.locations.description"),
      ctaText: t("featureCards.locations.cta"),
      href: "/services/locations",
    },
    {
      id: "parts-tricycles",
      image: "/dropdown/44.jpg",
      title: t("featureCards.parts.title"),
      description: t("featureCards.parts.description"),
      ctaText: t("featureCards.parts.cta"),
      href: "/services/parts",
    },
  ];
}



