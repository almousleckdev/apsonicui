// Unknown ids fallback to a dynamically generated detail page based on product specifications
export function getProductDetailContent(id: string): ProductDetailContent | undefined {
  const existingContent = PRODUCT_DETAIL_CONTENT[id];
  if (existingContent) {
    return existingContent;
  }

  // Find the product model to generate dynamic fallback details
  const product = PRODUCT_MODELS.find((p) => p.id === id);
  if (!product) {
    return undefined;
  }

  // Generate uniquely-customized detail page content for this product model
  return {
    id: product.id,
    hero: {
      headlineLines: [
        { text: product.brand, color: "white" },
        { text: product.model, color: "brand" },
      ],
      left: heroLeft,
      middle: heroMiddle,
      right: heroRight,
      rider: heroRider,
      topLeftBadge: heroTopLeftBadge,
    },
    keyFeatures: {
      title: "Key Performance Features",
      subtitleHighlight: product.model,
      subtitleRest: " features",
      background: keyFeaturesBackground,
      items: [
        {
          title: "Engine",
          image: engineImg,
          tall: true,
          layout: "below",
          metric: { value: product.displacement || 125, unit: "cc" },
        },
        {
          title: "Frame",
          image: frameImg,
          layout: "inline-top",
          label: "Laden weight capacity",
          metric: { value: 250, unit: "kg" },
        },
        {
          title: "Headlights",
          image: headlightImg,
          layout: "below",
          text: "LED",
        },
        {
          title: "Rear absorber",
          image: rearAbsorberImg,
          layout: "bottom-right",
          text: "Reinforced",
        },
        {
          title: "Pedal",
          image: pedalImg,
          layout: "bottom-left",
          highlight: { lines: ["Multi", "functional"], trail: "and foldable" },
        },
      ],
    },
    storySplit: {
      title: `APSONIC ${product.model}`,
      description:
        `The all-new developed APSONIC ${product.model} model features high reliability, excellent fuel economy, and outstanding carrying performance, making it perfectly suited for heavy-duty work and complex road conditions.`,
      background: storySplitBackground,
      variants: [
        {
          id: "black",
          colorLabel: "Black",
          dotColor: "#111111",
          image: storySplitBlack,
        },
        {
          id: "red",
          colorLabel: "Red",
          dotColor: "#7a2130",
          image: storySplitRed,
        },
      ],
    },
    specBanners: [
      {
        id: "frame",
        background: frameBanner,
        align: "right",
        titleLines: ["Reinforced Frame"],
        description:
          `Built with high-strength materials and advanced chassis design, the ${product.model} offers superior stability and structural durability.`,
      },
      {
        id: "engine",
        background: engineBanner,
        align: "left",
        titleLines: ["Reliable Engine"],
        description:
          `Equipped with a robust ${product.displacement || 125}cc engine designed to deliver consistent power and high fuel efficiency under heavy loads.`,
      },
    ],
  };
}

export function getKnownProductDetailIds(): string[] {
  const existingIds = Object.keys(PRODUCT_DETAIL_CONTENT);
  const modelIds = PRODUCT_MODELS.map((p) => p.id);
  return Array.from(new Set([...existingIds, ...modelIds]));
}
